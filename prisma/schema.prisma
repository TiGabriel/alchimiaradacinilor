// Alchimia Rădăcinilor — relational data model.
//
// Conventions (see docs/DECISIONS.md):
// - IDs are time-ordered UUIDv7 strings generated by Prisma.
// - Money is stored as integers in minor units (bani; 100 bani = 1 RON).
// - Tables are snake_case plurals via @@map; columns keep Prisma camelCase.
// - Join tables use composite primary keys and may carry extra columns
//   (position, weight, …).
// - Derived values (discount, thumbnail, subcategory) are NOT stored; they are
//   computed in services. The only denormalised caches are Product.rating and
//   Product.reviewCount, maintained by the review service.
// - Orders keep snapshots of names/prices/addresses: that is the legal record
//   of a purchase, not duplicated catalogue data.
// - CHECK constraints Prisma cannot express live in the migration SQL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum ProductType {
  INDIVIDUAL_OIL
  BLEND
  KIT
  DIFFUSER
  ACCESSORY
  OTHER
}

enum ProductRelationType {
  RELATED
  UPSELL
  CROSS_SELL
}

enum QuizQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

enum RoutineTimeOfDay {
  MORNING
  DAY
  EVENING
  ANYTIME
}

enum RoutineDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CARD
  CASH_ON_DELIVERY
  BANK_TRANSFER
}

enum AddressType {
  SHIPPING
  BILLING
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriberStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
}

enum ConsentPurpose {
  NECESSARY
  ANALYTICS
  MARKETING
  NEWSLETTER
  TERMS
  PRIVACY_POLICY
  /// Using wishlist/purchases/saved routines to personalise recommendations.
  PERSONALIZATION
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity & access (Session/Account/Verification follow Better Auth's schema)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid(7))
  email           String    @unique
  /// Set when the email address was verified (required before ordering).
  emailVerifiedAt DateTime?
  firstName       String
  lastName        String
  image           String?
  phone           String?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  roles          UserRole[]
  sessions       Session[]
  accounts       Account[]
  addresses      Address[]
  cart           Cart?
  wishlist       Wishlist?
  orders         Order[]
  reviews        Review[]
  savedRoutines  SavedRoutine[]
  quizResults    QuizResult[]
  articles       Article[]
  couponUsages   CouponUsage[]
  consents       ConsentRecord[]
  subscriber     NewsletterSubscriber?
  mediaUploads   MediaAsset[]
  settingUpdates SiteSetting[]
  orderEvents    OrderStatusEvent[]    @relation("OrderEventActor")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid(7))
  key         String   @unique // customer | editor | admin
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Server-side session. `token` holds the SHA-256 hash of the cookie value, never the raw token.
model Session {
  id        String   @id @default(uuid(7))
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid(7))
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

/// One-time tokens (email verification, password reset). `value` is the SHA-256 hash of the token.
model Verification {
  id         String   @id @default(uuid(7))
  /// "<purpose>:<userId>", e.g. "email-verification:…", "password-reset:…".
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([value])
  @@map("verifications")
}

model Address {
  id                String   @id @default(uuid(7))
  userId            String
  label             String?
  firstName         String
  lastName          String
  phone             String
  companyName       String?
  vatNumber         String? // CUI / CIF
  tradeRegisterNo   String? // Nr. Reg. Com.
  street            String
  streetExtra       String?
  city              String
  county            String // județ
  postalCode        String
  country           String   @default("RO")
  isDefaultShipping Boolean  @default(false)
  isDefaultBilling  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ─────────────────────────────────────────────────────────────────────────────
// Media & SEO (shared by many entities)
// ─────────────────────────────────────────────────────────────────────────────

model MediaAsset {
  id          String   @id @default(uuid(7))
  storageKey  String   @unique
  url         String
  mimeType    String
  width       Int?
  height      Int?
  sizeBytes   Int?
  alt         String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  productImages  ProductImage[]
  categoryImages Category[]
  brandLogos     Brand[]
  collectionImgs Collection[]
  routineImages  Routine[]
  articleCovers  Article[]
  seoOgImages    SeoMeta[]
  needIcons      Need[]

  @@map("media_assets")
}

/// SEO metadata shared 1:1 by Product, Category, Brand, Collection, Routine,
/// Article and ArticleCategory. Add new SEO fields here once.
model SeoMeta {
  id              String   @id @default(uuid(7))
  seoTitle        String?
  metaDescription String?
  canonicalUrl    String?
  ogImageId       String?
  noIndex         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ogImage MediaAsset? @relation(fields: [ogImageId], references: [id], onDelete: SetNull)

  product         Product?
  category        Category?
  brand           Brand?
  collection      Collection?
  routine         Routine?
  article         Article?
  articleCategory ArticleCategory?

  @@map("seo_meta")
}

// ─────────────────────────────────────────────────────────────────────────────
// Catalogue
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(uuid(7))
  name        String
  slug        String   @unique
  description String?
  parentId    String?
  position    Int      @default(0)
  active      Boolean  @default(true)
  imageId     String?
  seoId       String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent      Category?        @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[]       @relation("CategoryTree")
  image       MediaAsset?      @relation(fields: [imageId], references: [id], onDelete: SetNull)
  seo         SeoMeta?         @relation(fields: [seoId], references: [id], onDelete: SetNull)
  products    Product[]
  couponLinks CouponCategory[]

  @@index([parentId, position])
  @@map("categories")
}

model Brand {
  id          String   @id @default(uuid(7))
  name        String
  slug        String   @unique
  description String?
  website     String?
  logoId      String?
  active      Boolean  @default(true)
  isDemo      Boolean  @default(false)
  seoId       String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  logo     MediaAsset? @relation(fields: [logoId], references: [id], onDelete: SetNull)
  seo      SeoMeta?    @relation(fields: [seoId], references: [id], onDelete: SetNull)
  products Product[]

  @@map("brands")
}

model Product {
  id               String      @id @default(uuid(7))
  name             String
  slug             String      @unique
  sku              String      @unique
  brandId          String?
  /// Most specific category node. Category + subcategory are derived from the tree.
  categoryId       String
  productType      ProductType
  shortDescription String
  /// Markdown.
  description      String
  /// Markdown. Must not contain medical/therapeutic claims.
  usageInfo        String?
  /// Markdown.
  safetyInfo       String?
  /// Minor units (bani).
  price            Int
  /// Minor units (bani). Discount is derived from compareAtPrice - price.
  compareAtPrice   Int?
  stock            Int         @default(0)
  /// Type-specific specs (volume, diffuser capacity…), validated per productType by Zod.
  attributes       Json?
  /// Cached average of approved reviews (maintained by the review service).
  rating           Float?
  /// Cached count of approved reviews (maintained by the review service).
  reviewCount      Int         @default(0)
  featured         Boolean     @default(false)
  active           Boolean     @default(true)
  isDemo           Boolean     @default(false)
  seoId            String?     @unique
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  brand    Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  seo      SeoMeta? @relation(fields: [seoId], references: [id], onDelete: SetNull)

  images          ProductImage[]
  ingredients     ProductIngredient[]
  tags            ProductTag[]
  needs           ProductNeed[]
  aromaProfiles   ProductAromaProfile[]
  kitItems        KitItem[]             @relation("KitProduct")
  partOfKits      KitItem[]             @relation("KitComponent")
  relations       ProductRelation[]     @relation("ProductRelationSource")
  relatedFrom     ProductRelation[]     @relation("ProductRelationTarget")
  collections     CollectionProduct[]
  routineProducts RoutineProduct[]
  routineSteps    RoutineStep[]
  articleLinks    ArticleProduct[]
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]
  orderItems      OrderItem[]
  reviews         Review[]
  quizResults     QuizResultProduct[]
  couponLinks     CouponProduct[]

  @@index([categoryId])
  @@index([brandId])
  @@index([active, featured])
  @@index([productType])
  @@index([createdAt])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid(7))
  productId String
  mediaId   String
  /// Position 0 is the thumbnail.
  position  Int      @default(0)
  alt       String?
  createdAt DateTime @default(now())

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([productId, position])
  @@index([mediaId])
  @@map("product_images")
}

model Ingredient {
  id          String   @id @default(uuid(7))
  name        String
  slug        String   @unique
  latinName   String?
  inciName    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products ProductIngredient[]

  @@map("ingredients")
}

model ProductIngredient {
  productId    String
  ingredientId String
  position     Int     @default(0)
  note         String?

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([productId, ingredientId])
  @@index([ingredientId])
  @@map("product_ingredients")
}

/// A kit's contents are other products, never copied text.
model KitItem {
  kitId       String
  componentId String
  quantity    Int    @default(1)
  position    Int    @default(0)

  kit       Product @relation("KitProduct", fields: [kitId], references: [id], onDelete: Cascade)
  component Product @relation("KitComponent", fields: [componentId], references: [id], onDelete: Restrict)

  @@id([kitId, componentId])
  @@index([componentId])
  @@map("kit_items")
}

model ProductRelation {
  productId String
  relatedId String
  type      ProductRelationType @default(RELATED)
  position  Int                 @default(0)

  product Product @relation("ProductRelationSource", fields: [productId], references: [id], onDelete: Cascade)
  related Product @relation("ProductRelationTarget", fields: [relatedId], references: [id], onDelete: Cascade)

  @@id([productId, relatedId, type])
  @@index([relatedId])
  @@map("product_relations")
}

model Collection {
  id          String   @id @default(uuid(7))
  name        String
  slug        String   @unique
  description String?
  imageId     String?
  position    Int      @default(0)
  active      Boolean  @default(true)
  isDemo      Boolean  @default(false)
  seoId       String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  image    MediaAsset?         @relation(fields: [imageId], references: [id], onDelete: SetNull)
  seo      SeoMeta?            @relation(fields: [seoId], references: [id], onDelete: SetNull)
  products CollectionProduct[]

  @@map("collections")
}

model CollectionProduct {
  collectionId String
  productId    String
  position     Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
  @@map("collection_products")
}

model Tag {
  id        String   @id @default(uuid(7))
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products    ProductTag[]
  routines    RoutineTag[]
  articles    ArticleTag[]
  quizAnswers QuizAnswerTag[]

  @@map("tags")
}

model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
  @@map("product_tags")
}

model Need {
  id          String   @id @default(uuid(7))
  name        String
  slug        String   @unique
  description String?
  iconId      String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  icon        MediaAsset?      @relation(fields: [iconId], references: [id], onDelete: SetNull)
  products    ProductNeed[]
  routines    RoutineNeed[]
  quizAnswers QuizAnswerNeed[]

  @@map("needs")
}

model ProductNeed {
  productId String
  needId    String
  /// How strongly the product fits this need (1 = default).
  relevance Int    @default(1)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  need    Need    @relation(fields: [needId], references: [id], onDelete: Cascade)

  @@id([productId, needId])
  @@index([needId])
  @@map("product_needs")
}

model AromaProfile {
  id          String   @id @default(uuid(7))
  name        String
  slug        String   @unique
  description String?
  colorHex    String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    ProductAromaProfile[]
  quizAnswers QuizAnswerAromaProfile[]

  @@map("aroma_profiles")
}

model ProductAromaProfile {
  productId      String
  aromaProfileId String
  /// 1–5
  intensity      Int    @default(3)

  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  aromaProfile AromaProfile @relation(fields: [aromaProfileId], references: [id], onDelete: Cascade)

  @@id([productId, aromaProfileId])
  @@index([aromaProfileId])
  @@map("product_aroma_profiles")
}

// ─────────────────────────────────────────────────────────────────────────────
// Quiz
// ─────────────────────────────────────────────────────────────────────────────

model Quiz {
  id          String   @id @default(uuid(7))
  slug        String   @unique
  title       String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions QuizQuestion[]
  results   QuizResult[]

  @@map("quizzes")
}

model QuizQuestion {
  id        String           @id @default(uuid(7))
  quizId    String
  /// Stable identifier within the quiz (seed/admin upserts).
  key       String
  position  Int              @default(0)
  text      String
  helpText  String?
  type      QuizQuestionType @default(SINGLE_CHOICE)
  required  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@unique([quizId, key])
  @@index([quizId, position])
  @@map("quiz_questions")
}

model QuizAnswer {
  id         String   @id @default(uuid(7))
  questionId String
  /// Stable identifier within the question (seed/admin upserts).
  key        String
  position   Int      @default(0)
  text       String
  icon       String?
  /// Budget ceiling this answer expresses (bani); products above it are penalised.
  maxPrice   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question      QuizQuestion             @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tags          QuizAnswerTag[]
  needs         QuizAnswerNeed[]
  aromaProfiles QuizAnswerAromaProfile[]
  productTypes  QuizAnswerProductType[]
  resultAnswers QuizResultAnswer[]

  @@unique([questionId, key])
  @@index([questionId, position])
  @@map("quiz_answers")
}

/// Weight may be negative (e.g. "I don't like floral scents").
model QuizAnswerTag {
  answerId String
  tagId    String
  weight   Int    @default(1)

  answer QuizAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  tag    Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([answerId, tagId])
  @@index([tagId])
  @@map("quiz_answer_tags")
}

model QuizAnswerNeed {
  answerId String
  needId   String
  weight   Int    @default(1)

  answer QuizAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  need   Need       @relation(fields: [needId], references: [id], onDelete: Cascade)

  @@id([answerId, needId])
  @@index([needId])
  @@map("quiz_answer_needs")
}

model QuizAnswerAromaProfile {
  answerId       String
  aromaProfileId String
  weight         Int    @default(1)

  answer       QuizAnswer   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  aromaProfile AromaProfile @relation(fields: [aromaProfileId], references: [id], onDelete: Cascade)

  @@id([answerId, aromaProfileId])
  @@index([aromaProfileId])
  @@map("quiz_answer_aroma_profiles")
}

/// Weight towards (or, when negative, away from) a product type, e.g. "Am deja un difuzor".
model QuizAnswerProductType {
  answerId    String
  productType ProductType
  weight      Int         @default(1)

  answer QuizAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@id([answerId, productType])
  @@map("quiz_answer_product_types")
}

model QuizResult {
  id                   String   @id @default(uuid(7))
  quizId               String
  userId               String?
  /// Cookie-scoped id for guests.
  anonymousId          String?
  recommendedRoutineId String?
  createdAt            DateTime @default(now())

  quiz               Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  recommendedRoutine Routine?            @relation(fields: [recommendedRoutineId], references: [id], onDelete: SetNull)
  answers            QuizResultAnswer[]
  products           QuizResultProduct[]

  @@index([userId])
  @@index([anonymousId])
  @@map("quiz_results")
}

model QuizResultAnswer {
  resultId String
  answerId String

  result QuizResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  answer QuizAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@id([resultId, answerId])
  @@map("quiz_result_answers")
}

/// Snapshot of what was recommended at the time (history, not catalogue data).
model QuizResultProduct {
  resultId  String
  productId String
  /// Engine score × 100 at the time of the quiz.
  score     Int
  rank      Int
  /// Human-readable explanation shown to the customer ("Recomandat pentru că…").
  reason    String?

  result  QuizResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([resultId, productId])
  @@map("quiz_result_products")
}

// ─────────────────────────────────────────────────────────────────────────────
// Routines
// ─────────────────────────────────────────────────────────────────────────────

model Routine {
  id              String            @id @default(uuid(7))
  title           String
  slug            String            @unique
  summary         String
  /// Markdown.
  description     String?
  timeOfDay       RoutineTimeOfDay  @default(ANYTIME)
  difficulty      RoutineDifficulty @default(BEGINNER)
  durationMinutes Int?
  /// Recommended frequency, e.g. "Zilnic, seara" (free text).
  frequency       String?
  imageId         String?
  featured        Boolean           @default(false)
  active          Boolean           @default(true)
  isDemo          Boolean           @default(false)
  seoId           String?           @unique
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  image       MediaAsset?      @relation(fields: [imageId], references: [id], onDelete: SetNull)
  seo         SeoMeta?         @relation(fields: [seoId], references: [id], onDelete: SetNull)
  needs       RoutineNeed[]
  tags        RoutineTag[]
  articles    ArticleRoutine[]
  products    RoutineProduct[]
  steps       RoutineStep[]
  savedBy     SavedRoutine[]
  quizResults QuizResult[]

  @@map("routines")
}

model RoutineNeed {
  routineId String
  needId    String

  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  need    Need    @relation(fields: [needId], references: [id], onDelete: Cascade)

  @@id([routineId, needId])
  @@index([needId])
  @@map("routine_needs")
}

model RoutineTag {
  routineId String
  tagId     String

  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([routineId, tagId])
  @@index([tagId])
  @@map("routine_tags")
}

model RoutineProduct {
  routineId  String
  productId  String
  position   Int     @default(0)
  isOptional Boolean @default(false)
  note       String?

  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([routineId, productId])
  @@index([productId])
  @@map("routine_products")
}

model RoutineStep {
  id              String   @id @default(uuid(7))
  routineId       String
  position        Int      @default(0)
  title           String
  /// Markdown.
  instructions    String
  durationMinutes Int?
  productId       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  routine Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([routineId, position])
  @@index([productId])
  @@map("routine_steps")
}

model SavedRoutine {
  userId    String
  routineId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@id([userId, routineId])
  @@index([routineId])
  @@map("saved_routines")
}

// ─────────────────────────────────────────────────────────────────────────────
// Content (Jurnal)
// ─────────────────────────────────────────────────────────────────────────────

model ArticleCategory {
  id          String   @id @default(uuid(7))
  name        String
  slug        String   @unique
  description String?
  parentId    String?
  position    Int      @default(0)
  seoId       String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   ArticleCategory?  @relation("ArticleCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children ArticleCategory[] @relation("ArticleCategoryTree")
  seo      SeoMeta?          @relation(fields: [seoId], references: [id], onDelete: SetNull)
  articles Article[]

  @@map("article_categories")
}

model Article {
  id           String        @id @default(uuid(7))
  title        String
  slug         String        @unique
  excerpt      String?
  /// Markdown.
  content      String
  coverImageId String?
  authorId     String?
  /// Byline when the author is not a user account (e.g. "Echipa Alchimia Rădăcinilor").
  authorName   String?
  categoryId   String?
  status       ContentStatus @default(DRAFT)
  publishedAt  DateTime?
  featured     Boolean       @default(false)
  isDemo       Boolean       @default(false)
  seoId        String?       @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  coverImage MediaAsset?      @relation(fields: [coverImageId], references: [id], onDelete: SetNull)
  author     User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  category   ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  seo        SeoMeta?         @relation(fields: [seoId], references: [id], onDelete: SetNull)
  products   ArticleProduct[]
  routines   ArticleRoutine[]
  tags       ArticleTag[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@map("articles")
}

model ArticleProduct {
  articleId String
  productId String
  position  Int    @default(0)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([articleId, productId])
  @@index([productId])
  @@map("article_products")
}

model ArticleRoutine {
  articleId String
  routineId String
  position  Int    @default(0)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@id([articleId, routineId])
  @@index([routineId])
  @@map("article_routines")
}

model ArticleTag {
  articleId String
  tagId     String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
  @@map("article_tags")
}

// ─────────────────────────────────────────────────────────────────────────────
// Commerce
// ─────────────────────────────────────────────────────────────────────────────

model Cart {
  id        String    @id @default(uuid(7))
  /// Set for logged-in customers.
  userId    String?   @unique
  /// Opaque cookie token for guests.
  token     String?   @unique
  couponId  String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user   User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items  CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid(7))
  cartId    String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

model Wishlist {
  id        String   @id @default(uuid(7))
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([wishlistId, productId])
  @@index([productId])
  @@map("wishlist_items")
}

model Order {
  id                   String        @id @default(uuid(7))
  /// Human-readable, e.g. AR-2026-000123.
  number               String        @unique
  userId               String?
  email                String
  phone                String?
  status               OrderStatus   @default(PENDING)
  paymentStatus        PaymentStatus @default(UNPAID)
  paymentMethod        PaymentMethod
  currency             String        @default("RON")
  /// All totals are minor units (bani), snapshotted at checkout.
  subtotal             Int
  discountTotal        Int           @default(0)
  shippingTotal        Int           @default(0)
  /// VAT included in the prices above.
  taxTotal             Int           @default(0)
  total                Int
  couponId             String?
  /// Snapshot of the applied code (the coupon itself may later change or be deleted).
  couponCode           String?
  /// Snapshot of the chosen delivery method (from SiteSettings at checkout).
  shippingMethodCode   String
  shippingMethodName   String
  customerNote         String?
  /// Terms & privacy acceptance at checkout (versions from the legal setting).
  termsAcceptedAt      DateTime
  termsVersion         String
  privacyPolicyVersion String
  placedAt             DateTime      @default(now())
  paidAt               DateTime?
  shippedAt            DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon      Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  addresses   OrderAddress[]
  couponUsage CouponUsage?
  events      OrderStatusEvent[]

  @@index([userId])
  @@index([status])
  @@index([placedAt])
  @@map("orders")
}

/// Snapshot of the address at purchase time (invoice record).
/// Append-only status history (customer-visible timeline + audit trail).
model OrderStatusEvent {
  id            String         @id @default(uuid(7))
  orderId       String
  status        OrderStatus
  paymentStatus PaymentStatus?
  /// Shown to the customer when present.
  note          String?
  /// Who made the change (admin); null for the customer/system.
  actorId       String?
  /// Set when the customer was emailed about this change.
  notifiedAt    DateTime?
  createdAt     DateTime       @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation("OrderEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_events")
}

/// Per-year counter behind human-friendly order numbers (AR-2026-000123).
model OrderCounter {
  year  Int @id
  value Int @default(0)

  @@map("order_counters")
}

model OrderAddress {
  id              String      @id @default(uuid(7))
  orderId         String
  type            AddressType
  firstName       String
  lastName        String
  phone           String
  companyName     String?
  vatNumber       String?
  tradeRegisterNo String?
  street          String
  streetExtra     String?
  city            String
  county          String
  postalCode      String
  country         String      @default("RO")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, type])
  @@map("order_addresses")
}

/// Snapshot of the product at purchase time; productId is kept for linking.
model OrderItem {
  id          String  @id @default(uuid(7))
  orderId     String
  productId   String?
  productName String
  /// Snapshots for display after the product changes or is deleted.
  productSlug String?
  imageUrl    String?
  sku         String
  /// Minor units (bani).
  unitPrice   Int
  quantity    Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  reviews Review[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Coupon {
  id               String     @id @default(uuid(7))
  /// Stored upper-case.
  code             String     @unique
  description      String?
  type             CouponType
  /// Percentage (1–100) for PERCENTAGE, bani for FIXED_AMOUNT, ignored for FREE_SHIPPING.
  value            Int        @default(0)
  minSubtotal      Int?
  maxDiscount      Int?
  startsAt         DateTime?
  endsAt           DateTime?
  usageLimit       Int?
  perCustomerLimit Int?
  active           Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  usages     CouponUsage[]
  orders     Order[]
  carts      Cart[]
  /// Optional restrictions: when any are set, the coupon applies only to matching lines.
  products   CouponProduct[]
  categories CouponCategory[]

  @@map("coupons")
}

model CouponProduct {
  couponId  String
  productId String

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@index([productId])
  @@map("coupon_products")
}

/// A category restriction also covers its subcategories.
model CouponCategory {
  couponId   String
  categoryId String

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
  @@index([categoryId])
  @@map("coupon_categories")
}

model CouponUsage {
  id             String   @id @default(uuid(7))
  couponId       String
  orderId        String   @unique
  userId         String?
  email          String
  discountAmount Int
  createdAt      DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([couponId])
  @@index([userId])
  @@map("coupon_usages")
}

model Review {
  id          String       @id @default(uuid(7))
  productId   String
  userId      String
  /// Present when the review is tied to a purchase (verified buyer).
  orderItemId String?
  /// 1–5
  rating      Int
  title       String?
  body        String
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@unique([productId, userId])
  @@index([productId, status])
  @@map("reviews")
}

// ─────────────────────────────────────────────────────────────────────────────
// Marketing & compliance
// ─────────────────────────────────────────────────────────────────────────────

model NewsletterSubscriber {
  id               String           @id @default(uuid(7))
  email            String           @unique
  userId           String?          @unique
  status           SubscriberStatus @default(PENDING)
  confirmTokenHash String?
  source           String?
  confirmedAt      DateTime?
  unsubscribedAt   DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user     User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  consents ConsentRecord[]

  @@map("newsletter_subscribers")
}

/// Append-only. The current consent is the latest record per subject + purpose.
model ConsentRecord {
  id            String         @id @default(uuid(7))
  userId        String?
  subscriberId  String?
  anonymousId   String?
  purpose       ConsentPurpose
  granted       Boolean
  policyVersion String
  source        String?
  ipHash        String?
  userAgent     String?
  createdAt     DateTime       @default(now())

  user       User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscriber NewsletterSubscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)

  @@index([userId, purpose, createdAt])
  @@index([anonymousId, purpose, createdAt])
  @@index([subscriberId])
  @@map("consent_records")
}

/// Key/value settings; each key's value is validated by a Zod schema in
/// src/validation/settings.ts, so new settings need no migration.
model SiteSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("site_settings")
}
