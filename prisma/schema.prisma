// Alchimia Rădăcinilor — relational data model.
//
// Conventions (see docs/DECISIONS.md):
// - IDs are time-ordered UUIDv7 strings generated by Prisma.
// - Money is stored as integers in minor units (bani; 100 bani = 1 RON).
// - Tables are snake_case plurals via @@map; columns keep Prisma camelCase.
// - Join tables use composite primary keys and may carry extra columns
//   (position, weight, …).
// - Derived values (thumbnail, subcategory) are NOT stored; they are
//   computed in services. The only denormalised caches are Product.rating and
//   Product.reviewCount, maintained by the review service.
// - The site does not sell (products are bought on doTERRA). The former shop
//   tables live in the `legacy_commerce` schema, outside this model.
// - CHECK constraints Prisma cannot express live in the migration SQL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum ProductType {
  INDIVIDUAL_OIL
  BLEND
  KIT
  DIFFUSER
  ACCESSORY
  OTHER
}

enum ProductRelationType {
  RELATED
  UPSELL
  CROSS_SELL
}

enum QuizQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

enum RoutineTimeOfDay {
  MORNING
  DAY
  EVENING
  ANYTIME
}

enum RoutineDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Result of the admin's last "Testează linkul" on a product's doTERRA link.
enum LinkStatus {
  UNCHECKED
  OK
  BROKEN
}

enum SubscriberStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
}

enum ConsentPurpose {
  NECESSARY
  ANALYTICS
  MARKETING
  NEWSLETTER
  TERMS
  PRIVACY_POLICY
  /// Using wishlist/purchases/saved routines to personalise recommendations.
  PERSONALIZATION
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity & access (Session/Account/Verification follow Better Auth's schema)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid(7))
  email           String    @unique
  /// Set when the email address was verified (required before writing a review).
  emailVerifiedAt DateTime?
  firstName       String
  lastName        String
  image           String?
  phone           String?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  roles            UserRole[]
  sessions         Session[]
  accounts         Account[]
  wishlist         Wishlist?
  reviews          Review[]
  savedRoutines    SavedRoutine[]
  quizResults      QuizResult[]
  articles         Article[]
  consents         ConsentRecord[]
  subscriber       NewsletterSubscriber?
  mediaUploads     MediaAsset[]
  settingUpdates   SiteSetting[]
  moderatedReviews Review[]              @relation("ReviewModerator")
  campaigns        NewsletterCampaign[]
  productViews     ProductView[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid(7))
  key         String   @unique // customer | editor | admin
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users UserRole[]

  @@map("roles")
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Server-side session. `token` holds the SHA-256 hash of the cookie value, never the raw token.
model Session {
  id        String   @id @default(uuid(7))
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid(7))
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

/// One-time tokens (email verification, password reset). `value` is the SHA-256 hash of the token.
model Verification {
  id         String   @id @default(uuid(7))
  /// "<purpose>:<userId>", e.g. "email-verification:…", "password-reset:…".
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([value])
  @@map("verifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// Media & SEO (shared by many entities)
// ─────────────────────────────────────────────────────────────────────────────

model MediaAsset {
  id          String   @id @default(uuid(7))
  storageKey  String   @unique
  url         String
  mimeType    String
  width       Int?
  height      Int?
  sizeBytes   Int?
  alt         String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  productImages  ProductImage[]
  categoryImages Category[]
  brandLogos     Brand[]
  collectionImgs Collection[]
  routineImages  Routine[]
  articleCovers  Article[]
  seoOgImages    SeoMeta[]
  needIcons      Need[]
  reviewImages   Review[]

  @@map("media_assets")
}

/// SEO metadata shared 1:1 by Product, Category, Brand, Collection, Routine,
/// Article and ArticleCategory. Add new SEO fields here once.
model SeoMeta {
  id              String   @id @default(uuid(7))
  seoTitle        String?
  metaDescription String?
  canonicalUrl    String?
  ogImageId       String?
  noIndex         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ogImage MediaAsset? @relation(fields: [ogImageId], references: [id], onDelete: SetNull)

  product         Product?
  category        Category?
  brand           Brand?
  collection      Collection?
  routine         Routine?
  article         Article?
  articleCategory ArticleCategory?

  @@map("seo_meta")
}

// ─────────────────────────────────────────────────────────────────────────────
// Catalogue
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(uuid(7))
  name        String
  slug        String   @unique
  description String?
  parentId    String?
  position    Int      @default(0)
  active      Boolean  @default(true)
  imageId     String?
  seoId       String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?   @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[]  @relation("CategoryTree")
  image    MediaAsset? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  seo      SeoMeta?    @relation(fields: [seoId], references: [id], onDelete: SetNull)
  products Product[]

  @@index([parentId, position])
  @@map("categories")
}

model Brand {
  id          String   @id @default(uuid(7))
  name        String
  slug        String   @unique
  description String?
  website     String?
  logoId      String?
  active      Boolean  @default(true)
  isDemo      Boolean  @default(false)
  seoId       String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  logo     MediaAsset? @relation(fields: [logoId], references: [id], onDelete: SetNull)
  seo      SeoMeta?    @relation(fields: [seoId], references: [id], onDelete: SetNull)
  products Product[]

  @@map("brands")
}

model Product {
  id                String      @id @default(uuid(7))
  name              String
  slug              String      @unique
  sku               String      @unique
  brandId           String?
  /// Most specific category node. Category + subcategory are derived from the tree.
  categoryId        String
  productType       ProductType
  shortDescription  String
  /// Markdown.
  description       String
  /// Markdown. Must not contain medical/therapeutic claims.
  usageInfo         String?
  /// Markdown.
  safetyInfo        String?
  /// Price a visitor sees on the doTERRA site, in minor units (bani). No markup.
  price             Int
  /// When the admin last confirmed `price` against the doTERRA site.
  priceCheckedAt    DateTime?
  /// Full doTERRA referral link, pasted by the admin (https, host allowed by the affiliate setting).
  referralUrl       String?
  /// doTERRA item number (e.g. 60201755), optional.
  doterraItemNumber String?     @unique
  /// Last time the admin tested `referralUrl`; reset when the link changes.
  linkCheckedAt     DateTime?
  linkStatus        LinkStatus  @default(UNCHECKED)
  /// Unused since the site stopped selling (no discounts); dropped in a later migration.
  compareAtPrice    Int?
  /// Unused since the site stopped selling (no stock); dropped in a later migration.
  stock             Int         @default(0)
  /// Type-specific specs (volume, diffuser capacity…), validated per productType by Zod.
  attributes        Json?
  /// Cached average of approved reviews (maintained by the review service).
  rating            Float?
  /// Cached count of approved reviews (maintained by the review service).
  reviewCount       Int         @default(0)
  featured          Boolean     @default(false)
  active            Boolean     @default(true)
  isDemo            Boolean     @default(false)
  seoId             String?     @unique
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  brand    Brand?   @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  seo      SeoMeta? @relation(fields: [seoId], references: [id], onDelete: SetNull)

  images          ProductImage[]
  ingredients     ProductIngredient[]
  tags            ProductTag[]
  needs           ProductNeed[]
  aromaProfiles   ProductAromaProfile[]
  kitItems        KitItem[]             @relation("KitProduct")
  partOfKits      KitItem[]             @relation("KitComponent")
  relations       ProductRelation[]     @relation("ProductRelationSource")
  relatedFrom     ProductRelation[]     @relation("ProductRelationTarget")
  collections     CollectionProduct[]
  routineProducts RoutineProduct[]
  routineSteps    RoutineStep[]
  articleLinks    ArticleProduct[]
  wishlistItems   WishlistItem[]
  reviews         Review[]
  quizResults     QuizResultProduct[]
  views           ProductView[]
  outboundClicks  OutboundClickDaily[]

  @@index([categoryId])
  @@index([brandId])
  @@index([active, featured])
  @@index([productType])
  @@index([createdAt])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid(7))
  productId String
  mediaId   String
  /// Position 0 is the thumbnail.
  position  Int      @default(0)
  alt       String?
  createdAt DateTime @default(now())

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@unique([productId, position])
  @@index([mediaId])
  @@map("product_images")
}

model Ingredient {
  id          String   @id @default(uuid(7))
  name        String
  slug        String   @unique
  latinName   String?
  inciName    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products ProductIngredient[]

  @@map("ingredients")
}

model ProductIngredient {
  productId    String
  ingredientId String
  position     Int     @default(0)
  note         String?

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([productId, ingredientId])
  @@index([ingredientId])
  @@map("product_ingredients")
}

/// A kit's contents are other products, never copied text.
model KitItem {
  kitId       String
  componentId String
  quantity    Int    @default(1)
  position    Int    @default(0)

  kit       Product @relation("KitProduct", fields: [kitId], references: [id], onDelete: Cascade)
  component Product @relation("KitComponent", fields: [componentId], references: [id], onDelete: Restrict)

  @@id([kitId, componentId])
  @@index([componentId])
  @@map("kit_items")
}

model ProductRelation {
  productId String
  relatedId String
  type      ProductRelationType @default(RELATED)
  position  Int                 @default(0)

  product Product @relation("ProductRelationSource", fields: [productId], references: [id], onDelete: Cascade)
  related Product @relation("ProductRelationTarget", fields: [relatedId], references: [id], onDelete: Cascade)

  @@id([productId, relatedId, type])
  @@index([relatedId])
  @@map("product_relations")
}

model Collection {
  id          String   @id @default(uuid(7))
  name        String
  slug        String   @unique
  description String?
  imageId     String?
  position    Int      @default(0)
  active      Boolean  @default(true)
  isDemo      Boolean  @default(false)
  seoId       String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  image    MediaAsset?         @relation(fields: [imageId], references: [id], onDelete: SetNull)
  seo      SeoMeta?            @relation(fields: [seoId], references: [id], onDelete: SetNull)
  products CollectionProduct[]

  @@map("collections")
}

model CollectionProduct {
  collectionId String
  productId    String
  position     Int    @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
  @@map("collection_products")
}

model Tag {
  id        String   @id @default(uuid(7))
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products    ProductTag[]
  routines    RoutineTag[]
  articles    ArticleTag[]
  quizAnswers QuizAnswerTag[]

  @@map("tags")
}

model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
  @@map("product_tags")
}

model Need {
  id          String   @id @default(uuid(7))
  name        String
  slug        String   @unique
  description String?
  iconId      String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  icon        MediaAsset?      @relation(fields: [iconId], references: [id], onDelete: SetNull)
  products    ProductNeed[]
  routines    RoutineNeed[]
  quizAnswers QuizAnswerNeed[]

  @@map("needs")
}

model ProductNeed {
  productId String
  needId    String
  /// How strongly the product fits this need (1 = default).
  relevance Int    @default(1)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  need    Need    @relation(fields: [needId], references: [id], onDelete: Cascade)

  @@id([productId, needId])
  @@index([needId])
  @@map("product_needs")
}

model AromaProfile {
  id          String   @id @default(uuid(7))
  name        String
  slug        String   @unique
  description String?
  colorHex    String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    ProductAromaProfile[]
  quizAnswers QuizAnswerAromaProfile[]

  @@map("aroma_profiles")
}

model ProductAromaProfile {
  productId      String
  aromaProfileId String
  /// 1–5
  intensity      Int    @default(3)

  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  aromaProfile AromaProfile @relation(fields: [aromaProfileId], references: [id], onDelete: Cascade)

  @@id([productId, aromaProfileId])
  @@index([aromaProfileId])
  @@map("product_aroma_profiles")
}

// ─────────────────────────────────────────────────────────────────────────────
// Quiz
// ─────────────────────────────────────────────────────────────────────────────

model Quiz {
  id          String   @id @default(uuid(7))
  slug        String   @unique
  title       String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions QuizQuestion[]
  results   QuizResult[]

  @@map("quizzes")
}

model QuizQuestion {
  id        String           @id @default(uuid(7))
  quizId    String
  /// Stable identifier within the quiz (seed/admin upserts).
  key       String
  position  Int              @default(0)
  text      String
  helpText  String?
  type      QuizQuestionType @default(SINGLE_CHOICE)
  required  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@unique([quizId, key])
  @@index([quizId, position])
  @@map("quiz_questions")
}

model QuizAnswer {
  id         String   @id @default(uuid(7))
  questionId String
  /// Stable identifier within the question (seed/admin upserts).
  key        String
  position   Int      @default(0)
  text       String
  icon       String?
  /// Budget ceiling this answer expresses (bani); products above it are penalised.
  maxPrice   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question      QuizQuestion             @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tags          QuizAnswerTag[]
  needs         QuizAnswerNeed[]
  aromaProfiles QuizAnswerAromaProfile[]
  productTypes  QuizAnswerProductType[]
  resultAnswers QuizResultAnswer[]

  @@unique([questionId, key])
  @@index([questionId, position])
  @@map("quiz_answers")
}

/// Weight may be negative (e.g. "I don't like floral scents").
model QuizAnswerTag {
  answerId String
  tagId    String
  weight   Int    @default(1)

  answer QuizAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  tag    Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([answerId, tagId])
  @@index([tagId])
  @@map("quiz_answer_tags")
}

model QuizAnswerNeed {
  answerId String
  needId   String
  weight   Int    @default(1)

  answer QuizAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  need   Need       @relation(fields: [needId], references: [id], onDelete: Cascade)

  @@id([answerId, needId])
  @@index([needId])
  @@map("quiz_answer_needs")
}

model QuizAnswerAromaProfile {
  answerId       String
  aromaProfileId String
  weight         Int    @default(1)

  answer       QuizAnswer   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  aromaProfile AromaProfile @relation(fields: [aromaProfileId], references: [id], onDelete: Cascade)

  @@id([answerId, aromaProfileId])
  @@index([aromaProfileId])
  @@map("quiz_answer_aroma_profiles")
}

/// Weight towards (or, when negative, away from) a product type, e.g. "Am deja un difuzor".
model QuizAnswerProductType {
  answerId    String
  productType ProductType
  weight      Int         @default(1)

  answer QuizAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@id([answerId, productType])
  @@map("quiz_answer_product_types")
}

model QuizResult {
  id                   String   @id @default(uuid(7))
  quizId               String
  userId               String?
  /// Cookie-scoped id for guests.
  anonymousId          String?
  recommendedRoutineId String?
  createdAt            DateTime @default(now())

  quiz               Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  recommendedRoutine Routine?            @relation(fields: [recommendedRoutineId], references: [id], onDelete: SetNull)
  answers            QuizResultAnswer[]
  products           QuizResultProduct[]

  @@index([userId])
  @@index([anonymousId])
  @@map("quiz_results")
}

model QuizResultAnswer {
  resultId String
  answerId String

  result QuizResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  answer QuizAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@id([resultId, answerId])
  @@map("quiz_result_answers")
}

/// Snapshot of what was recommended at the time (history, not catalogue data).
model QuizResultProduct {
  resultId  String
  productId String
  /// Engine score × 100 at the time of the quiz.
  score     Int
  rank      Int
  /// Human-readable explanation shown to the customer ("Recomandat pentru că…").
  reason    String?

  result  QuizResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([resultId, productId])
  @@map("quiz_result_products")
}

// ─────────────────────────────────────────────────────────────────────────────
// Routines
// ─────────────────────────────────────────────────────────────────────────────

model Routine {
  id              String            @id @default(uuid(7))
  title           String
  slug            String            @unique
  summary         String
  /// Markdown.
  description     String?
  timeOfDay       RoutineTimeOfDay  @default(ANYTIME)
  difficulty      RoutineDifficulty @default(BEGINNER)
  durationMinutes Int?
  /// Recommended frequency, e.g. "Zilnic, seara" (free text).
  frequency       String?
  imageId         String?
  featured        Boolean           @default(false)
  active          Boolean           @default(true)
  isDemo          Boolean           @default(false)
  seoId           String?           @unique
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  image       MediaAsset?      @relation(fields: [imageId], references: [id], onDelete: SetNull)
  seo         SeoMeta?         @relation(fields: [seoId], references: [id], onDelete: SetNull)
  needs       RoutineNeed[]
  tags        RoutineTag[]
  articles    ArticleRoutine[]
  products    RoutineProduct[]
  steps       RoutineStep[]
  savedBy     SavedRoutine[]
  quizResults QuizResult[]

  @@map("routines")
}

model RoutineNeed {
  routineId String
  needId    String

  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  need    Need    @relation(fields: [needId], references: [id], onDelete: Cascade)

  @@id([routineId, needId])
  @@index([needId])
  @@map("routine_needs")
}

model RoutineTag {
  routineId String
  tagId     String

  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([routineId, tagId])
  @@index([tagId])
  @@map("routine_tags")
}

model RoutineProduct {
  routineId  String
  productId  String
  position   Int     @default(0)
  isOptional Boolean @default(false)
  note       String?

  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([routineId, productId])
  @@index([productId])
  @@map("routine_products")
}

model RoutineStep {
  id              String   @id @default(uuid(7))
  routineId       String
  position        Int      @default(0)
  title           String
  /// Markdown.
  instructions    String
  durationMinutes Int?
  productId       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  routine Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([routineId, position])
  @@index([productId])
  @@map("routine_steps")
}

model SavedRoutine {
  userId    String
  routineId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@id([userId, routineId])
  @@index([routineId])
  @@map("saved_routines")
}

// ─────────────────────────────────────────────────────────────────────────────
// Content (Jurnal)
// ─────────────────────────────────────────────────────────────────────────────

model ArticleCategory {
  id          String   @id @default(uuid(7))
  name        String
  slug        String   @unique
  description String?
  parentId    String?
  position    Int      @default(0)
  seoId       String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   ArticleCategory?  @relation("ArticleCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children ArticleCategory[] @relation("ArticleCategoryTree")
  seo      SeoMeta?          @relation(fields: [seoId], references: [id], onDelete: SetNull)
  articles Article[]

  @@map("article_categories")
}

model Article {
  id           String        @id @default(uuid(7))
  title        String
  slug         String        @unique
  excerpt      String?
  /// Markdown.
  content      String
  coverImageId String?
  authorId     String?
  /// Byline when the author is not a user account (e.g. "Echipa Alchimia Rădăcinilor").
  authorName   String?
  categoryId   String?
  status       ContentStatus @default(DRAFT)
  publishedAt  DateTime?
  featured     Boolean       @default(false)
  isDemo       Boolean       @default(false)
  seoId        String?       @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  coverImage MediaAsset?      @relation(fields: [coverImageId], references: [id], onDelete: SetNull)
  author     User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  category   ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  seo        SeoMeta?         @relation(fields: [seoId], references: [id], onDelete: SetNull)
  products   ArticleProduct[]
  routines   ArticleRoutine[]
  tags       ArticleTag[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@map("articles")
}

model ArticleProduct {
  articleId String
  productId String
  position  Int    @default(0)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([articleId, productId])
  @@index([productId])
  @@map("article_products")
}

model ArticleRoutine {
  articleId String
  routineId String
  position  Int    @default(0)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@id([articleId, routineId])
  @@index([routineId])
  @@map("article_routines")
}

model ArticleTag {
  articleId String
  tagId     String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
  @@map("article_tags")
}

// ─────────────────────────────────────────────────────────────────────────────
// Saved products & reviews
// ─────────────────────────────────────────────────────────────────────────────

model Wishlist {
  id        String   @id @default(uuid(7))
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([wishlistId, productId])
  @@index([productId])
  @@map("wishlist_items")
}

model Review {
  id              String       @id @default(uuid(7))
  productId       String
  userId          String
  /// Set on reviews written while the site still sold products (verified buyer).
  /// The order rows themselves are archived in `legacy_commerce.order_items`.
  orderItemId     String?
  /// 1–5
  rating          Int
  title           String?
  body            String
  status          ReviewStatus @default(PENDING)
  /// Optional customer photo (stored via the storage abstraction, re-encoded without metadata).
  imageId         String?
  moderatedAt     DateTime?
  moderatedById   String?
  /// Reason shown to the author when a review is not published.
  rejectionReason String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  image       MediaAsset? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  moderatedBy User?       @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@unique([productId, userId])
  @@index([productId, status])
  @@index([status, createdAt])
  @@map("reviews")
}

// ─────────────────────────────────────────────────────────────────────────────
// Marketing & compliance
// ─────────────────────────────────────────────────────────────────────────────

model NewsletterSubscriber {
  id                    String           @id @default(uuid(7))
  email                 String           @unique
  userId                String?          @unique
  status                SubscriberStatus @default(PENDING)
  confirmTokenHash      String?
  confirmTokenExpiresAt DateTime?
  /// Where the subscription started (footer, homepage, account…).
  source                String?
  firstName             String?
  /// Segmentation: interests picked by the subscriber (need/aroma slugs).
  interests             String[]         @default([])
  lastEmailedAt         DateTime?
  confirmedAt           DateTime?
  unsubscribedAt        DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  user     User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  consents ConsentRecord[]

  @@index([status])
  @@map("newsletter_subscribers")
}

enum CampaignStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

/// Newsletter campaign (sent only with a configured provider, to ACTIVE subscribers with consent).
model NewsletterCampaign {
  id              String         @id @default(uuid(7))
  subject         String
  preheader       String?
  heading         String
  /// Plain paragraphs separated by blank lines (rendered with the shared email layout).
  body            String
  /// Designed HTML sent through Brevo, with Brevo's own tags ({{ unsubscribe }}, {{ mirror }}…).
  html            String?
  /// Segment filter, validated by `campaignSegmentSchema`.
  segment         Json           @default("{}")
  status          CampaignStatus @default(DRAFT)
  recipientCount  Int            @default(0)
  deliveredCount  Int            @default(0)
  failedCount     Int            @default(0)
  createdById     String?
  /// Id of the campaign created in Brevo, kept from the first attempt so a retry never creates a second one.
  brevoCampaignId Int?           @unique
  sentAt          DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@map("newsletter_campaigns")
}

/// First-party analytics events, recorded only with ANALYTICS consent. No IPs, no fingerprints.
model AnalyticsEvent {
  id          String   @id @default(uuid(7))
  name        String
  /// Random id from the consented analytics cookie (not linked to the account).
  anonymousId String
  path        String?
  props       Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([name, createdAt])
  @@index([createdAt])
  @@map("analytics_events")
}

/// Recently viewed products of signed-in customers — kept only with PERSONALIZATION consent.
model ProductView {
  userId    String
  productId String
  viewedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([userId, viewedAt])
  @@map("product_views")
}

/// Clicks on "Cumpără de pe doTERRA", counted per product, day (Europe/Bucharest) and page.
/// Aggregate only: no visitor id, IP or cookie, so no consent is needed.
model OutboundClickDaily {
  productId String
  day       DateTime @db.Date
  /// Where the button was: produs, previzualizare, quiz, ritual, favorite…
  source    String
  count     Int      @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, day, source])
  @@index([day])
  @@map("outbound_clicks_daily")
}

/// Append-only. The current consent is the latest record per subject + purpose.
model ConsentRecord {
  id            String         @id @default(uuid(7))
  userId        String?
  subscriberId  String?
  anonymousId   String?
  purpose       ConsentPurpose
  granted       Boolean
  policyVersion String
  source        String?
  ipHash        String?
  userAgent     String?
  createdAt     DateTime       @default(now())

  user       User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscriber NewsletterSubscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)

  @@index([userId, purpose, createdAt])
  @@index([anonymousId, purpose, createdAt])
  @@index([subscriberId])
  @@map("consent_records")
}

/// Key/value settings; each key's value is validated by a Zod schema in
/// src/validation/settings.ts, so new settings need no migration.
model SiteSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("site_settings")
}
