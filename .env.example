# ─────────────────────────────────────────────────────────────────────────────
# Alchimia Rădăcinilor — environment variables
# Copy to `.env` for local development. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma (app, migrations and seed).
# Managed databases: add ?sslmode=require; use the pooled URL for the app and the
# direct URL when running `pnpm db:deploy`.
DATABASE_URL="postgresql://alchimia:alchimia@localhost:5432/alchimia?schema=public"
# Direct (non-pooled) URL, read only by the Prisma CLI (migrations, seed). Leave empty
# locally; on Netlify + Neon set it to the connection string without "-pooler".
DIRECT_DATABASE_URL=""
# Separate database for integration tests (optional; unit tests do not need it).
# The tests migrate it and TRUNCATE its tables — never reuse a real database here.
DATABASE_URL_TEST="postgresql://alchimia:alchimia@localhost:5432/alchimia_test?schema=public"

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL, without a trailing slash. Used for canonical URLs, sitemap,
# Open Graph tags and links in emails. In production: https://alchimiaradacinilor.ro
# — an https URL also turns on HSTS and upgrade-insecure-requests (read at build
# time as well: redeploy after changing it).
APP_URL="http://localhost:3000"
# Optional fallback for code that runs in the browser; leave empty unless APP_URL
# cannot be used there.
# NEXT_PUBLIC_APP_URL="https://alchimiaradacinilor.ro"

# ── Authentication ───────────────────────────────────────────────────────────
# Random secret of at least 32 characters. Required in production. Signs the
# one-click newsletter unsubscribe links and salts pseudonymised IP addresses
# stored with consent records. Changing it invalidates old unsubscribe links.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# First administrator — used only by `pnpm admin:create` (see README). Leave empty
# in deployed environments; pass them on the command line instead.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_FIRST_NAME=""
ADMIN_LAST_NAME=""

# ── Email ────────────────────────────────────────────────────────────────────
# Which driver sends transactional email: console (prints to the terminal,
# for development) | resend | smtp
EMAIL_PROVIDER="console"
# Sender address on a domain verified by the provider, e.g.
# "Alchimia Rădăcinilor <noreply@alchimiaradacinilor.ro>". The display name and the
# reply-to address can be changed later in Admin → Setări → Email. A sending domain
# is not a mailbox: replies go to the reply-to address, so set one that is read.
EMAIL_FROM=""
# Optional sender for contact-form notifications, on the same verified domain, e.g.
# "Alchimia Rădăcinilor <contact@alchimiaradacinilor.ro>". Falls back to EMAIL_FROM.
# The notifications go to the email in Admin → Setări → Contact, with the visitor's
# address as Reply-To.
EMAIL_FROM_CONTACT=""
# Resend API key (only when EMAIL_PROVIDER=resend).
RESEND_API_KEY=""
# SMTP credentials (only when EMAIL_PROVIDER=smtp). Port 587 = STARTTLS, 465 = TLS.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# ── File storage ─────────────────────────────────────────────────────────────
# Where uploaded images live: local (./storage/uploads, served by /uploads/…;
# development or a single self-hosted server) | netlify (Netlify Blobs, also served by
# /uploads/…; works only on Netlify) | s3 (any other serverless host, e.g. Vercel)
STORAGE_DRIVER="local"
# S3-compatible bucket (AWS S3, Cloudflare R2, …) — only when STORAGE_DRIVER=s3.
# S3_ENDPOINT only for non-AWS providers (e.g. https://<account>.r2.cloudflarestorage.com);
# S3_REGION "auto" for R2. Give the key only Put/Get/DeleteObject on this bucket.
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL the bucket's files are served from (CDN or bucket URL). Its origin
# is allowed by the image optimiser (build time) and the Content Security Policy.
S3_PUBLIC_URL=""

# ── Product photography (script only) ────────────────────────────────────────
# Read only by `pnpm images:products` on a developer machine, never by the site.
# OpenAI API key with access to the image models (billed per image). Leave empty
# in deployed environments.
OPENAI_API_KEY=""
# Optional: image model and quality (defaults: gpt-image-2.5-sunburst, high).
# PRODUCT_IMAGE_MODEL="gpt-image-2.5-sunburst"
# PRODUCT_IMAGE_QUALITY="high"

# ── Seed ─────────────────────────────────────────────────────────────────────
# "false" seeds taxonomy, quiz, journal categories and settings without the demo
# catalogue (use it for production). Default: demo data included.
SEED_DEMO=""

# ── Email marketing (Brevo) ──────────────────────────────────────────────────
# Optional. When both are set, confirmed newsletter subscribers are mirrored to one
# Brevo list and withdrawals are removed from it (the site's database keeps the
# consent records). Campaigns with a designed HTML can be sent to that list from
# Admin → Newsletter → campaign → "Trimite prin Brevo" (also needs BREVO_SENDER_EMAIL).
# Existing subscribers: `pnpm newsletter:sync` (dry run) then `--apply`.
# API key: Brevo → your name (top right) → SMTP & API → API Keys. If "Authorised IPs"
# is on (Security), the server's outgoing IPs must be allowed or every call fails.
BREVO_API_KEY=""
# Numeric id of the Brevo list (Contacts → Lists).
BREVO_LIST_ID=""
# Sender of the campaigns sent through Brevo, e.g. "noreply@alchimiaradacinilor.ro".
# It must be added and verified in Brevo (Senders, Domains & Dedicated IPs), on an
# authenticated domain. Leave empty to keep "Trimite prin Brevo" off.
BREVO_SENDER_EMAIL=""
# Optional sender name shown in the inbox. Default: the shop name (Admin → Setări).
BREVO_SENDER_NAME=""
# Random secret (≥ 24 characters) that Brevo sends with its marketing webhook,
# as the header "X-Webhook-Secret" (or as a bearer token), to
# https://<APP_URL>/api/newsletter/brevo. Generate one with: openssl rand -hex 32
BREVO_WEBHOOK_SECRET=""

# ── Card payments (NETOPIA Payments) ─────────────────────────────────────────
# Shipping prices, payment texts and bank details (IBAN) are site settings, edited
# in Admin → Setări, not environment variables. Card payments are offered only when
# every variable below is set AND "Card bancar" is ticked in Admin → Setări → Plată.
# See docs/PAYMENTS.md. Never put live keys in a non-production environment, nor
# sandbox keys in production.
# sandbox (test cards, no real money) | live. Leave empty to keep card payments off.
NETOPIA_ENV=""
# API key from the NETOPIA admin (Profile → Security), for the environment above.
NETOPIA_API_KEY=""
# Point-of-sale signature (XXXX-XXXX-XXXX-XXXX-XXXX) from the NETOPIA admin.
NETOPIA_POS_SIGNATURE=""
# NETOPIA's public certificate/key (PEM) for that point of sale, used to verify the
# payment notifications. Paste it as is, or on one line with \n between its lines.
NETOPIA_PUBLIC_KEY=""
