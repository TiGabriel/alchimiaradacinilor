# ─────────────────────────────────────────────────────────────────────────────
# Alchimia Rădăcinilor — environment variables
# Copy to `.env` for local development. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma (app, migrations and seed).
# Managed databases: add ?sslmode=require; use the pooled URL for the app and the
# direct URL when running `pnpm db:deploy`.
DATABASE_URL="postgresql://alchimia:alchimia@localhost:5432/alchimia?schema=public"
# Separate database for integration tests (optional; unit tests do not need it).
# The tests migrate it and TRUNCATE its tables — never reuse a real database here.
DATABASE_URL_TEST="postgresql://alchimia:alchimia@localhost:5432/alchimia_test?schema=public"

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL, without a trailing slash. Used for canonical URLs, sitemap,
# Open Graph tags and links in emails. In production: https://alchimiaradacinilor.ro
# — an https URL also turns on HSTS and upgrade-insecure-requests (read at build
# time as well: redeploy after changing it).
APP_URL="http://localhost:3000"
# Optional fallback for code that runs in the browser; leave empty unless APP_URL
# cannot be used there.
# NEXT_PUBLIC_APP_URL="https://alchimiaradacinilor.ro"

# ── Authentication ───────────────────────────────────────────────────────────
# Random secret of at least 32 characters. Required in production. Signs the
# one-click newsletter unsubscribe links and salts pseudonymised IP addresses
# stored with consent records. Changing it invalidates old unsubscribe links.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# First administrator — used only by `pnpm admin:create` (see README). Leave empty
# in deployed environments; pass them on the command line instead.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_FIRST_NAME=""
ADMIN_LAST_NAME=""

# ── Email ────────────────────────────────────────────────────────────────────
# Which driver sends transactional email: console (prints to the terminal,
# for development) | resend | smtp
EMAIL_PROVIDER="console"
# Sender address on a domain verified by the provider, e.g.
# "Alchimia Rădăcinilor <salut@alchimiaradacinilor.ro>". The display name and the
# reply-to address can be changed later in Admin → Setări → Email.
EMAIL_FROM=""
# Resend API key (only when EMAIL_PROVIDER=resend).
RESEND_API_KEY=""
# SMTP credentials (only when EMAIL_PROVIDER=smtp). Port 587 = STARTTLS, 465 = TLS.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# ── File storage ─────────────────────────────────────────────────────────────
# Where uploaded images live: local (./storage/uploads, served by /uploads/…;
# development or a single self-hosted server) | s3 (required on Vercel/serverless)
STORAGE_DRIVER="local"
# S3-compatible bucket (AWS S3, Cloudflare R2, …) — only when STORAGE_DRIVER=s3.
# S3_ENDPOINT only for non-AWS providers (e.g. https://<account>.r2.cloudflarestorage.com);
# S3_REGION "auto" for R2. Give the key only Put/Get/DeleteObject on this bucket.
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL the bucket's files are served from (CDN or bucket URL). Its origin
# is allowed by the image optimiser (build time) and the Content Security Policy.
S3_PUBLIC_URL=""

# ── Seed ─────────────────────────────────────────────────────────────────────
# "false" seeds taxonomy, quiz, journal categories and settings without the demo
# catalogue (use it for production). Default: demo data included.
SEED_DEMO=""

# ── Payments (future — not read by the code yet) ─────────────────────────────
# Shipping prices, payment texts and bank details (IBAN) are site settings, edited
# in Admin → Setări, not environment variables. See docs/PAYMENTS.md for adding
# card payments.
# Stripe keys, if card payments go through Stripe.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Netopia (Romanian processor), if chosen instead of / alongside Stripe.
NETOPIA_API_KEY=""
NETOPIA_POS_SIGNATURE=""
