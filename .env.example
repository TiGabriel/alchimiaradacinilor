# ─────────────────────────────────────────────────────────────────────────────
# Alchimia Rădăcinilor — environment variables
# Copy to `.env` for local development. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma (app, migrations and seed).
DATABASE_URL="postgresql://alchimia:alchimia@localhost:5432/alchimia?schema=public"
# Separate database for integration tests (optional; unit tests do not need it).
DATABASE_URL_TEST="postgresql://alchimia:alchimia@localhost:5432/alchimia_test?schema=public"

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL, without a trailing slash. Used for canonical URLs, sitemap,
# Open Graph tags and links in emails.
APP_URL="http://localhost:3000"

# ── Authentication ───────────────────────────────────────────────────────────
# Random secret of at least 32 characters. Required in production. Used to salt
# pseudonymised IP addresses stored with consent records.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# First administrator — used only by `pnpm admin:create` (see README).
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_FIRST_NAME=""
ADMIN_LAST_NAME=""

# ── Email ────────────────────────────────────────────────────────────────────
# Which driver sends transactional email: console (prints to the terminal,
# for development) | resend | smtp
EMAIL_PROVIDER="console"
# Sender shown to customers, e.g. "Alchimia Rădăcinilor <salut@example.ro>".
EMAIL_FROM=""
# Resend API key (only when EMAIL_PROVIDER=resend).
RESEND_API_KEY=""
# SMTP credentials (only when EMAIL_PROVIDER=smtp).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# ── File storage ─────────────────────────────────────────────────────────────
# Where uploaded images live: local (public/uploads, development only) | s3
STORAGE_DRIVER="local"
# S3-compatible bucket (AWS S3, Cloudflare R2, …) — only when STORAGE_DRIVER=s3.
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL the bucket's files are served from (CDN or bucket URL).
S3_PUBLIC_URL=""

# ── Payments (future — not used yet) ────────────────────────────────────────
# Stripe keys, if card payments go through Stripe.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Netopia (Romanian processor), if chosen instead of / alongside Stripe.
NETOPIA_API_KEY=""
NETOPIA_POS_SIGNATURE=""
